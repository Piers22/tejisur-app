<?xml version="1.0" encoding="utf-8"?>
<!-- Contenedor principal: secciones de Producción (HU01, HU02, HU03/HU16) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tejisur_background"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <FrameLayout
        android:id="@+id/contenedorFragment"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/tejisur_outline" />

    <!-- Barra de navegación inferior (sin Material Components para no cambiar el tema) -->
    <LinearLayout
        android:id="@+id/llNavegacion"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/tejisur_surface"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/navConsumo"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:drawablePadding="2dp"
            android:gravity="center"
            android:text="@string/nav_consumo"
            android:textSize="@dimen/text_error"
            app:drawableTopCompat="@drawable/ic_inventory_2" />

        <TextView
            android:id="@+id/navMerma"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:drawablePadding="2dp"
            android:gravity="center"
            android:text="@string/nav_merma"
            android:textSize="@dimen/text_error"
            app:drawableTopCompat="@drawable/ic_content_cut" />

        <TextView
            android:id="@+id/navConsulta"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:drawablePadding="2dp"
            android:gravity="center"
            android:text="@string/nav_consulta"
            android:textSize="@dimen/text_error"
            app:drawableTopCompat="@drawable/ic_analytics" />
    </LinearLayout>

</LinearLayout>
