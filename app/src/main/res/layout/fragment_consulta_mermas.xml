<?xml version="1.0" encoding="utf-8"?>
<!-- HU03 / HU16 - Consulta de mermas por lote y alertas de merma excesiva -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/clConsultaMermas"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tejisur_background"
    tools:context=".produccion.ui.ConsultaMermasFragment">

    <TextView
        android:id="@+id/tvTituloConsulta"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_screen"
        android:layout_marginTop="@dimen/margin_screen"
        android:layout_marginEnd="@dimen/margin_screen"
        android:text="@string/consulta_titulo"
        android:textColor="@color/tejisur_primary"
        android:textSize="@dimen/text_title"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvSubtituloConsulta"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_small"
        android:text="@string/consulta_subtitulo"
        android:textColor="@color/tejisur_text_secondary"
        android:textSize="@dimen/text_subtitle"
        app:layout_constraintEnd_toEndOf="@id/tvTituloConsulta"
        app:layout_constraintStart_toStartOf="@id/tvTituloConsulta"
        app:layout_constraintTop_toBottomOf="@id/tvTituloConsulta" />

    <!-- Filtros (HU03): lote, fibra, rango de fechas y orden por % -->
    <LinearLayout
        android:id="@+id/llFiltros"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:padding="12dp"
        app:layout_constraintEnd_toEndOf="@id/tvTituloConsulta"
        app:layout_constraintStart_toStartOf="@id/tvTituloConsulta"
        app:layout_constraintTop_toBottomOf="@id/tvSubtituloConsulta">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/margin_label"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvLabelFiltroLote"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/filtro_label_lote"
                    android:textColor="@color/tejisur_text_secondary"
                    android:textSize="@dimen/text_error"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/spinnerFiltroLote"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:spinnerMode="dropdown" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_label"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvLabelFiltroFibra"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/filtro_label_fibra"
                    android:textColor="@color/tejisur_text_secondary"
                    android:textSize="@dimen/text_error"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/spinnerFiltroFibra"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:spinnerMode="dropdown" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tvLabelFiltroFecha"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_label"
            android:text="@string/filtro_label_fecha"
            android:textColor="@color/tejisur_text_secondary"
            android:textSize="@dimen/text_error"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_small"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnFechaDesde"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="@dimen/margin_label"
                android:layout_weight="1"
                android:background="@drawable/bg_input"
                android:gravity="start|center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/filtro_fecha_desde"
                android:textAllCaps="false"
                android:textColor="@color/tejisur_text_primary"
                android:textSize="@dimen/text_subtitle" />

            <Button
                android:id="@+id/btnFechaHasta"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="@dimen/margin_label"
                android:layout_weight="1"
                android:background="@drawable/bg_input"
                android:gravity="start|center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/filtro_fecha_hasta"
                android:textAllCaps="false"
                android:textColor="@color/tejisur_text_primary"
                android:textSize="@dimen/text_subtitle" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvErrorFechas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_small"
            android:textColor="@color/tejisur_error"
            android:textSize="@dimen/text_error"
            android:visibility="gone"
            tools:text="@string/error_rango_fechas" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_small"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/swOrdenarPorcentaje"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/filtro_ordenar_porcentaje"
                android:textColor="@color/tejisur_text_primary"
                android:textSize="@dimen/text_subtitle" />

            <Button
                android:id="@+id/btnLimpiarFiltros"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_label"
                android:minWidth="0dp"
                android:text="@string/btn_limpiar_filtros"
                android:textAllCaps="false"
                android:textColor="@color/tejisur_primary"
                android:textSize="@dimen/text_subtitle"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Banner de alerta (HU16): lotes que superan el umbral -->
    <TextView
        android:id="@+id/tvBannerAlerta"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_banner_alerta"
        android:padding="12dp"
        android:textColor="@color/merma_excesiva"
        android:textSize="@dimen/text_subtitle"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="@id/tvTituloConsulta"
        app:layout_constraintStart_toStartOf="@id/tvTituloConsulta"
        app:layout_constraintTop_toBottomOf="@id/llFiltros"
        tools:text="⚠ 2 lotes superan el umbral de merma tolerable (5.0%)"
        tools:visibility="visible" />

    <!-- Leyenda de umbral (HU16): el texto se arma en código con el umbral de Planta -->
    <View
        android:id="@+id/viewLeyendaNormal"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:background="@color/merma_normal"
        app:layout_constraintBottom_toBottomOf="@id/tvLeyendaNormal"
        app:layout_constraintStart_toStartOf="@id/tvTituloConsulta"
        app:layout_constraintTop_toTopOf="@id/tvLeyendaNormal" />

    <TextView
        android:id="@+id/tvLeyendaNormal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_label"
        android:layout_marginTop="12dp"
        android:textColor="@color/tejisur_text_secondary"
        android:textSize="@dimen/text_error"
        app:layout_constraintStart_toEndOf="@id/viewLeyendaNormal"
        app:layout_constraintTop_toBottomOf="@id/tvBannerAlerta"
        tools:text="Dentro del umbral (≤ 5.0%)" />

    <View
        android:id="@+id/viewLeyendaExcesiva"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_marginStart="@dimen/margin_screen"
        android:background="@color/merma_excesiva"
        app:layout_constraintBottom_toBottomOf="@id/tvLeyendaNormal"
        app:layout_constraintStart_toEndOf="@id/tvLeyendaNormal"
        app:layout_constraintTop_toTopOf="@id/tvLeyendaNormal" />

    <TextView
        android:id="@+id/tvLeyendaExcesiva"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_label"
        android:textColor="@color/tejisur_text_secondary"
        android:textSize="@dimen/text_error"
        app:layout_constraintBaseline_toBaselineOf="@id/tvLeyendaNormal"
        app:layout_constraintEnd_toEndOf="@id/tvTituloConsulta"
        app:layout_constraintStart_toEndOf="@id/viewLeyendaExcesiva"
        tools:text="Merma excesiva (&gt; 5.0%)" />

    <!-- Cantidad de lotes tras aplicar filtros -->
    <TextView
        android:id="@+id/tvResultados"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_label"
        android:textColor="@color/tejisur_text_secondary"
        android:textSize="@dimen/text_error"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@id/tvTituloConsulta"
        app:layout_constraintStart_toStartOf="@id/tvTituloConsulta"
        app:layout_constraintTop_toBottomOf="@id/tvLeyendaNormal"
        tools:text="4 lotes encontrados" />

    <!-- Lista de lotes -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvLotesMerma"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/margin_small"
        android:clipToPadding="false"
        android:paddingStart="@dimen/margin_screen"
        android:paddingEnd="@dimen/margin_screen"
        android:paddingBottom="@dimen/margin_screen"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvResultados"
        tools:itemCount="4"
        tools:listitem="@layout/item_lote_merma" />

    <!-- Estado vacío: sin datos o sin coincidencias con los filtros -->
    <TextView
        android:id="@+id/tvSinRegistros"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/margin_screen"
        android:gravity="center"
        android:text="@string/consulta_sin_registros"
        android:textColor="@color/tejisur_text_secondary"
        android:textSize="@dimen/text_body"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/rvLotesMerma"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/rvLotesMerma" />

</androidx.constraintlayout.widget.ConstraintLayout>
